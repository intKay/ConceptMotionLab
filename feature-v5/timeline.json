  "captions": [
    {
      "t": 0,
      "big": "16 次抛掷，只看到一次结果。",
      "small": "正面出现 12 次，反面出现 4 次。"
    },
    {
      "t": 4,
      "big": "12 / 16 = 0.75",
      "small": "这枚硬币，真的偏了吗？"
    },
    {
      "t": 8,
      "big": "先建立模型，再衡量观察。",
      "small": "假设每次独立，正面概率都是 1/2。"
    },
    {
      "t": 12,
      "big": "一次分支，两个可能。",
      "small": "每条有序路径的概率，都是沿途概率相乘。"
    },
    {
      "t": 16,
      "big": "16 次分支，65,536 条路径。",
      "small": "公平独立模型：每条完整路径的概率为 2^(−16)。"
    },
    {
      "t": 20,
      "big": "路径等概率，结果却不等概率。",
      "small": "很多不同的次序，会得到相同的正面次数。"
    },
    {
      "t": 24,
      "big": "让每次抛掷，成为一次转向。",
      "small": "正面向右、反面向左；16 层就是 16 次试验。"
    },
    {
      "t": 29,
      "big": "每个小球都保留自己的路径。",
      "small": "固定种子模拟：共 1,536 条公平独立路径。"
    },
    {
      "t": 34,
      "big": "过程结束，结果开始堆积。",
      "small": "横坐标是正面次数；落在中间的路径更多。"
    },
    {
      "t": 40,
      "big": "保留次数，折叠次序。",
      "small": "随机变量 X，把一条路径映射成正面总数。"
    },
    {
      "t": 45,
      "big": "12 次正面，有 1,820 种次序。",
      "small": "C(16,12)=1,820；并不是只有一种走法。"
    },
    {
      "t": 49,
      "big": "8 次正面，有 12,870 种次序。",
      "small": "组合数的差异，塑造了二项分布。"
    },
    {
      "t": 54,
      "big": "条件，是对可能世界的裁剪。",
      "small": "64 格代表六次抛掷的全部前缀，用来缩小演示。"
    },
    {
      "t": 59,
      "big": "已知 A：第一枚是正面。",
      "small": "剩余 32 格；条件概率在这个新分母里计算。"
    },
    {
      "t": 64,
      "big": "再看 B：第二枚也是正面。",
      "small": "16/32=1/2；独立时，A 不改变 B 的概率。"
    },
    {
      "t": 70,
      "big": "路径的数量，成为概率的高度。",
      "small": "X~Binomial(16,1/2)，k 的范围是 0 到 16。"
    },
    {
      "t": 75,
      "big": "17 个概率相加，恰好等于 1。",
      "small": "P(X=k)=C(16,k)/65,536。"
    },
    {
      "t": 80,
      "big": "单点与累积，回答不同问题。",
      "small": "P(X=12)=2.78%；F(12)=P(X≤12)=98.94%。"
    },
    {
      "t": 86,
      "big": "期望，是概率质量的重心。",
      "small": "每个位置乘以自己的概率，再把贡献相加。"
    },
    {
      "t": 91,
      "big": "左右平衡，重心落在 8。",
      "small": "E[X]=Σ kP(X=k)=16×1/2=8。"
    },
    {
      "t": 96,
      "big": "期望是模型的中心。",
      "small": "它不是一次观察的保证，也不是最常见值的定义。"
    },
    {
      "t": 102,
      "big": "距离有正负，平方把它们留住。",
      "small": "先算 (k−8)²，再按对应的概率加权。"
    },
    {
      "t": 107,
      "big": "方差是 4，标准差是 2。",
      "small": "Var(X)=16×1/2×1/2=4；SD(X)=√4=2。"
    },
    {
      "t": 111,
      "big": "12 比重心多 4，即 2 个标准差。",
      "small": "这个距离值得注意，但还不是检验结论。"
    },
    {
      "t": 116,
      "big": "如果从 12/16 继续抛下去？",
      "small": "橙色轨迹保留这 16 次观察，再继续独立模拟。"
    },
    {
      "t": 121,
      "big": "不同的实验，有不同的起伏。",
      "small": "青色是另外 12 条独立模拟轨迹。"
    },
    {
      "t": 126,
      "big": "长期接近，不等于逐步接近。",
      "small": "大数定律：独立同分布的硬币频率趋向 1/2。"
    },
    {
      "t": 131,
      "big": "偶尔远离，不推翻长期趋势。",
      "small": "放大的末段里，仍有真实的上下波动。"
    },
    {
      "t": 136,
      "big": "换一个模型：明显偏斜的总体。",
      "small": "X~Exp(1)，均值 μ=1，标准差 σ=1。"
    },
    {
      "t": 141,
      "big": "一次取 n 个数，压成一个均值。",
      "small": "再重复抽样，观察这些均值自己的分布。"
    },
    {
      "t": 146,
      "big": "n 从 1，到 4，再到 16。",
      "small": "每种样本量模拟 4,608 组；密度使用同一尺度。"
    },
    {
      "t": 151,
      "big": "平均会缩小波动。",
      "small": "样本均值的标准误差 SE=σ/√n=1/√n。"
    },
    {
      "t": 156,
      "big": "只看收窄，还没有看完。",
      "small": "先把均值移到 0，再用标准误差统一尺度。"
    },
    {
      "t": 161,
      "big": "Z=(样本均值−1)/(1/√n)",
      "small": "三个直方图因此在同一条标准化数轴上比较。"
    },
    {
      "t": 166,
      "big": "在适当条件下，形状趋向正态。",
      "small": "本例满足独立同分布、有限方差；有限 n 仍有偏斜。"
    },
    {
      "t": 172,
      "big": "再换模型：正态总体，已知 σ=1。",
      "small": "每次抽 n=25 个数；演示中的真实参数 μ=0。"
    },
    {
      "t": 177,
      "big": "样本改变，区间也跟着移动。",
      "small": "区间：样本均值 ± 1.96×σ/√n。"
    },
    {
      "t": 182,
      "big": "让同一道程序，重复运行 40 次。",
      "small": "青色覆盖固定参数；橙色未覆盖。"
    },
    {
      "t": 188,
      "big": "95% 描述的是这道程序。",
      "small": "重复抽样约 95% 覆盖；40 次不保证恰好 38 次。"
    },
    {
      "t": 194,
      "big": "回到 16 抛 12 正面的观察。",
      "small": "H0：p=1/2；用精确二项双侧检验。"
    },
    {
      "t": 199,
      "big": "至少同样极端，是两端一起算。",
      "small": "X≤4 或 X≥12，距离 8 都至少为 4。"
    },
    {
      "t": 204,
      "big": "p 值 = 0.0768",
      "small": "它是 H0 下的尾部概率，不是 H0 为真的概率。"
    },
    {
      "t": 209,
      "big": "α=0.05：暂不拒绝 H0。",
      "small": "未拒绝不等于证明公平；p 值也不表示偏倚大小。"
    },
    {
      "t": 214,
      "big": "概率：从模型，推向数据。",
      "small": "统计：从数据，回望模型。"
    },
    {
      "t": 219,
      "big": "偶然的秩序",
      "small": "概率论与数理统计 · 一次观察，怎样成为证据"
    }
  ],
